annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["RutaGold","dim_empresa","Archivo de ejemplo","Parámetro1","Transformar archivo de ejemplo","Transformar archivo","dim_fecha","Archivo de ejemplo (2)","Parámetro2","Transformar archivo de ejemplo (2)","Transformar archivo (2)","dim_sector","Archivo de ejemplo (3)","Parámetro3","Transformar archivo de ejemplo (3)","Transformar archivo (3)","hechos","Archivo de ejemplo (4)","Parámetro4","Transformar archivo de ejemplo (4)","Transformar archivo (4)"]

